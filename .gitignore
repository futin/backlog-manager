registry.json
# No trailing slash, deliberately (bug-37): `node_modules/` would match the directory only, and git stores a symlink as a blob with mode 120000 — so an
# orchestrator worktree's `node_modules` link into the main tree went unignored and rode onto an item branch under `git add -A`. The bare pattern matches
# both forms, and nothing in this repo is legitimately named `node_modules`.
node_modules
*.log
.DS_Store
.idea/

# build output
dist/
*.tsbuildinfo

# local env
.env

# client build output
client/dist/

# claude code local state — scoped, not a blanket .claude/: this repo publishes
# itself as a plugin, so anything shared there stays trackable.
.claude/worktrees/
.claude/settings.local.json

# the container pnpm store, when it lands here instead of in the image
.pnpm-store/

# local design previews (scratch, never shipped)
.preview/

# superpowers visual-companion sessions
.superpowers/

# playwright MCP session artifacts (snapshots/traces), created wherever the
# server runs — the repo root and every orchestrator worktree alike
.playwright-mcp/
